# Kopieer naar .env.local en vul in met de waarden uit je Supabase project
# (Project Settings -> API). De anon-key is publiek: hij staat straks ook in
# de gebouwde JS. Dat is veilig zolang RLS aanstaat, zoals in supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
